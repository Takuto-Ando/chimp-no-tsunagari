+  observation?: Observation,
+  video?: Video,
+) {
+  const position = { x: (index % 2) * 230, y: Math.floor(index / 2) * 160 };
+  if (!observation || !video || video.width <= 0 || video.height <= 0)
+    return position;
+  const [left, top, right, bottom] = observation.bbox;
+  const centerX = Math.max(0, Math.min(1, (left + right) / (2 * video.width)));
+  const centerY = Math.max(0, Math.min(1, (top + bottom) / (2 * video.height)));
+  return {
+    x: position.x + (centerX - 0.5) * 64,
+    y: position.y + (centerY - 0.5) * 48,
+  };
+}
