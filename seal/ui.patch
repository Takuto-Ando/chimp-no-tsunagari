+import { describe, expect, it } from "vitest";
+import { graphPosition } from "../src/graphMotion";
+import type { Observation, Video } from "../src/domain";
+const video: Video = {
+  video_id: "sample",
+  width: 100,
+  height: 100,
+  fps: 10,
+  frame_count: 100,
+  recording_date: "",
+  strict_split: "gt",
+};
+const row: Observation = {
+  timestamp: 0,
+  track_id: "1",
+  individual_id: "1",
+  bbox: [0, 0, 20, 20],
+  confidence: null,
+};
+describe("video-synchronized graph", () => {
+  it("moves with the box and reproduces the same position after seeking", () => {
+    const start = graphPosition(0, row, video);
+    const end = graphPosition(0, { ...row, bbox: [80, 80, 100, 100] }, video);
+    expect(end.x).toBeGreaterThan(start.x);
+    expect(end.y).toBeGreaterThan(start.y);
+    expect(graphPosition(0, row, video)).toEqual(start);
+  });
+  it("normalizes different video resolutions", () => {
+    expect(
+      graphPosition(
+        0,
+        { ...row, bbox: [0, 0, 40, 40] },
+        { ...video, width: 200, height: 200 },
+      ),
+    ).toEqual(graphPosition(0, row, video));
+  });
+  it("keeps unobserved and malformed-size inputs finite", () => {
+    expect(graphPosition(3)).toEqual({ x: 230, y: 160 });
+    expect(graphPosition(3, row, { ...video, width: 0 })).toEqual(
+      graphPosition(3),
+    );
+  });
+});
