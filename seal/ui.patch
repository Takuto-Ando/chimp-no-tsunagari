+import { describe, expect, it } from "vitest";
+import { fixedRelationships } from "../src/fixedRelationships";
+
+describe("ID-fixed fictional relationships", () => {
+  it("keeps the same assignments regardless of input order", () => {
+    const identities = ["seal_track_03", "seal_track_01", "seal_track_02"];
+    expect(fixedRelationships(identities)).toEqual(
+      fixedRelationships([...identities].reverse()),
+    );
+    expect(identities[0]).toBe("seal_track_03");
+  });
+  it("never assigns a self-link or a duplicate pair", () => {
+    const relations = fixedRelationships(["id_1", "id_2", "id_2", "id_3"]);
+    expect(relations).toHaveLength(3);
+    expect(
+      relations.every((row) => row.individual_a !== row.individual_b),
+    ).toBe(true);
+    expect(new Set(relations.map((row) => row.id)).size).toBe(3);
+  });
+  it("has no relationship for unknown or single identities", () => {
+    expect(fixedRelationships([])).toEqual([]);
+    expect(fixedRelationships(["id_1"])).toEqual([]);
+  });
+});
