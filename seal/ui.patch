+import { type DemoRelationship, type DemoRelationshipKind } from "./domain";
+
+export function fixedRelationships(identities: string[]): DemoRelationship[] {
+  const sorted = [...new Set(identities)].sort((first, second) =>
+    first.localeCompare(second, "en", { numeric: true }),
+  );
+  const kinds: DemoRelationshipKind[] = ["friend", "rival", "companion"];
+  return sorted.flatMap((first, firstIndex) =>
+    sorted.slice(firstIndex + 1).map((second, offset) => ({
+      id: `fictional:${first}:${second}`,
+      individual_a: first,
+      individual_b: second,
+      kind: kinds[(firstIndex + offset) % kinds.length],
+    })),
+  );
+}
